<Project>
 <PropertyGroup>
  <TargetFramework>net10.0</TargetFramework><LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Deterministic>true</Deterministic><EnableNETAnalyzers>true</EnableNETAnalyzers><Version>0.2.1</Version><AssemblyVersion>0.2.1.0</AssemblyVersion><FileVersion>0.2.1.0</FileVersion>
  <GameDir Condition="'$(GameDir)' == ''">$(RIMWORLD_GAME_DIR)</GameDir>
  <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(RIMWORLD_HARMONY)</HarmonyPath>
 </PropertyGroup>
</Project>
